<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Location_Summary</name>
        <label>Build Location Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>locationSummary</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>currentLocationFormatted</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_service_locations</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Location_COunter</name>
        <label>Increment Location COunter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>locationCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Build_Location_Summary</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_No_locations_Found</name>
        <label>Set No locations Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>locationSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No service locations were found for this provider.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Service_Locations_Found</name>
        <label>Service Locations Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_No_locations_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Locations</defaultConnectorLabel>
        <rules>
            <name>Location_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>locationCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <label>Location Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Get Provider Service Locations Multiple {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Provider Service Locations Multiple</label>
    <loops>
        <name>Loop_through_service_locations</name>
        <label>Loop through service locations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Provider_Service_Locations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Location_COunter</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Service_Locations_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Provider_Service_Locations</name>
        <label>Get Provider Service Locations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_service_locations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Healthcare_Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>providerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Service_Location__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Provider_Service_Locations</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
