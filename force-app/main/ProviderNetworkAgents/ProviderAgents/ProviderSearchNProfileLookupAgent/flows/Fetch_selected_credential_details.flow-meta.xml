<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_counter</name>
        <label>Increment counter</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>counter</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_selected_Credential</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Credential_Details</name>
        <label>Set Credential Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>credentialDetails</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>credentialDetailsFormatted</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_Credentials</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_selected_Credential</name>
        <label>Is selected Credential?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_through_Credentials</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue loop</defaultConnectorLabel>
        <rules>
            <name>Selected_Credential</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>counter</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>credentialNumber</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Credential_Details</targetReference>
            </connector>
            <label>Selected Credential</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Fetch selected credential details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fetch selected credential details</label>
    <loops>
        <name>Loop_through_Credentials</name>
        <label>Loop through Credentials</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Provider_Credentials</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_counter</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Provider_Credentials</name>
        <label>Get Provider Credentials</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_through_Credentials</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Healthcare_Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>providerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Credential__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Provider_Credentials</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>credentialDetailsFormatted</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;strong&gt;Credential Name&lt;/strong&gt;: {!Loop_through_Credentials.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Credential Status: &lt;/strong&gt;{!Loop_through_Credentials.Credentialing_Status__c} &lt;/p&gt;&lt;p&gt;&lt;strong&gt;Application Date: &lt;/strong&gt;{!Loop_through_Credentials.Application_Date__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Current Stage: &lt;/strong&gt;{!Loop_through_Credentials.Current_Stage__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Assigned Analyst: &lt;/strong&gt;{!Loop_through_Credentials.Assigned_Analyst__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Expected Completion Date:&lt;/strong&gt; {!Loop_through_Credentials.Expected_Completion__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Committee Review Date:&lt;/strong&gt; {!Loop_through_Credentials.Committee_Review_Date__c}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Rejection Reason: &lt;/strong&gt;{!Loop_through_Credentials.Rejection_Reason__c}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>counter</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>credentialDetails</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>credentialNumber</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>providerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
