    <environments>Default</environments>
    <formulas>
        <name>Networkdataformula</name>
        <dataType>String</dataType>
        <expression>&quot;    Network Number : &quot; + TEXT({!Loopcount}) +
&quot;    Network Name : &quot;+ {!Network_loop.Network__r.Name} +
&quot;    Participation Status : &quot; + IF({!Network_loop.vlocity_ins__IsActive__c},&quot;Active&quot;,&quot;InActive&quot;) +
&quot;    Network Tier :  &quot; + TEXT({!Network_loop.ProviderNetworkTier__c})</expression>
    </formulas>
    <formulas>
        <name>NetworkLocations</name>
        <dataType>String</dataType>
        <expression> &quot;  Service location : &quot; + TEXT({!LoopCountofServiceLocations}) +&quot;.&quot; +  {!Location_loop.Location_Name__c}</expression>
    </formulas>
    <formulas>
        <name>ProviderDetailsformula</name>
        <dataType>String</dataType>
        <expression> &quot; Provider Name :  &quot; + {!Get_Provider.Name} +
 &quot; Provider NPI ID : &quot; + {!Get_Provider.NPI__c} +
 &quot; Provider Speciality : &quot;  + TEXT( {!Get_Provider.Speciality__c})+ 
 &quot; Provider City : &quot; + {!Get_Provider.City__c} + 
 &quot; Provider State : &quot; + {!Get_Provider.State__c} + 
 &quot; Provider Country : &quot; + {!Get_Provider.Country__c}</expression>
    </formulas>
