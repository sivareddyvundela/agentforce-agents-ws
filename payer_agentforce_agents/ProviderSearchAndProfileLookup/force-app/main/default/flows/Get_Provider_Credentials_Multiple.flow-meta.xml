<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>build</name>
        <label>build credential summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>credentialCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>credentialSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AppendCredentialSummary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Credentials</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Multiple_Creds</name>
        <label>Set Multiple Creds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>credentialSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MultipleCredentialMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_No_Credentials_Message</name>
        <label>Set No Credentials Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>credentialSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No credential records were found for this provider.No credential records were found for this provider.  </stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Single_Credential_Message</name>
        <label>Set Single Credential Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>credentialSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>credentialSummary</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Credential_Count</name>
        <label>Credential Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Noo_Credentials</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>credentialCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_No_Credentials_Message</targetReference>
            </connector>
            <label>No Credentials</label>
        </rules>
        <rules>
            <name>Single_Credential</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>credentialCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Single_Credential_Message</targetReference>
            </connector>
            <label>Single Credential</label>
        </rules>
        <rules>
            <name>Multiple_Credentials</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>credentialCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Multiple_Creds</targetReference>
            </connector>
            <label>Multiple Credentials</label>
        </rules>
    </decisions>
    <decisions>
        <name>Credentials_Count</name>
        <label>Credentials Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Credentials</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Credentials Found</defaultConnectorLabel>
        <rules>
            <name>No_Credentials</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Provider_Credentials</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No Credentials</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>AppendCredentialSummary</name>
        <dataType>String</dataType>
        <expression>{!credentialSummary} &amp;
TEXT({!credentialCount}) &amp; &quot;. &quot; &amp; BR() &amp;
&quot;Credential Name: &quot; &amp;
{!Loop_Through_Credentials.Name} &amp; BR() &amp;
&quot;Status: &quot; &amp;
{!Loop_Through_Credentials.Credentialing_Status__c} &amp; BR() &amp;
&quot;Current Stage: &quot; &amp;
{!Loop_Through_Credentials.Current_Stage__c}&amp; BR() &amp;
&quot;Application Date: &quot; &amp;
TEXT({!Loop_Through_Credentials.Application_Date__c}) &amp; BR() &amp;
BR()</expression>
    </formulas>
    <formulas>
        <name>MultipleCredentialMessage</name>
        <dataType>String</dataType>
        <expression>&quot;I found &quot; &amp;
TEXT({!credentialCount}) &amp;
&quot; credential records for this provider.&quot; &amp;
BR() &amp;
BR() &amp;
{!credentialSummary} &amp;
BR() &amp;
&quot;Please reply with the number of the credential you want to view.&quot;</expression>
    </formulas>
    <interviewLabel>Get Provider Credentials Multiple {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Provider Credentials Multiple</label>
    <loops>
        <name>Loop_Through_Credentials</name>
        <label>Loop Through Credentials</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Provider_Credentials</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>build</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Credential_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Provider_Credentials</name>
        <label>Get Provider Credentials</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Credentials_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Healthcare_Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>providerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Credential__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Provider_Credentials</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>credentialCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>credentialRecords</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Credential__c</objectType>
    </variables>
    <variables>
        <name>credentialSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>providerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>selectedCredential</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Credential__c</objectType>
    </variables>
</Flow>
