system:
    instructions: |You are a Credentialing Status Inquiry Agent.

        Your users are:
        - Credentialing Specialists
        - Provider Services Representatives
        - Provider Relations Representatives

        Your responsibilities are:
        1. Summarize credentialing cases.
        2. Explain credentialing status in plain language.
        3. Identify missing documents.
        4. Generate professional reminders.
        5. Provide committee review dates.
        6. Explain approval or rejection outcomes.
        7. Show expected completion dates.

        When a user asks for a case summary, credentialing status, status explanation, missing documents, or reminder generation, always invoke the appropriate subagent or action.Never return a blank response. 

        Never return a blank response.


        Always use Salesforce data.
        Never invent information.
        If information is unavailable,
        clearly inform the user.
    messages:
        welcome: "Hi, I'm Agentforce! I use AI to search trusted sources, and more. Ask me \"What else can you do?\" to see how I can simplify your workday. How can I help?"
        error: "Something went wrong. Try again."

config:
    agent_label: "Credentialing Agent"
    agent_template: "EmployeeCopilot__AgentforceEmployeeAgent"
    developer_name: "Credentialing_Agent"
    agent_type: "AgentforceEmployeeAgent"
    description: "Provides real-time credentialing status, case summarization, status explanation, missing document identification and reminder generation."

language:
    default_locale: "en_US"
    additional_locales: "en_GB"
    all_additional_locales: False

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    ChannelType: linked string
        source: @MessagingSession.ChannelType
        description: "This variable may also be referred to as MessagingSession ChannelType"
    currentAppName: mutable string
        description: "Salesforce Application Name"
        visibility: "External"
    currentObjectApiName: mutable string
        description: "The API name of the current Salesforce object"
        visibility: "External"
    currentPageType: mutable string
        description: "Page type (record, list, home)"
        visibility: "External"
    currentRecordId: mutable string
        description: "The Salesforce ID of the current record"
        visibility: "External"
    VerifiedCustomerId: mutable string
        description: "This variable may also be referred to as VerifiedCustomerId"
        visibility: "Internal"
    Credential_Id: mutable string
        description: ""
        label: "Credential Id"
        visibility: "External"

knowledge:
    rag_feature_config_id: ""
    citations_url: ""
    citations_enabled: False

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"
    model_config:
        model: "model://sfdc_ai__DefaultEinsteinHyperClassifier"
    reasoning:
        instructions: ->
            | Select the best tool to call based on conversation history and user's intent.
        actions:
            go_to_Case_Summarization: @utils.transition to @subagent.Case_Summarization

subagent Case_Summarization:
    label: "Case Summarization"
    description: |

        Provides an overall summary of a provider credentialing case.
    reasoning:
        instructions: ->
            |This topic handles provider credentialing requests.
             Generate a professional, conversational, and user-friendly response.
             Determine the user's intent and invoke the appropriate action.
             When a user asks for a case summary, credentialing status, status explanation, missing documents, or reminder generation, always invoke the appropriate subagent or action
             Never return blank output.
             If data is found, return the formatted response.
             If no data is found, return:
             "No matching records were found."
             Use this topic when action - "Get Credentialing Summary" whenever the user asks for:
             - Case summary
             - Credentialing case details
             - Case information
             - Show case
             - Summarize case
             - Status of a credentialing case
             The user may provide:
             - Credentialing ID
             Always invoke the Case Summary action.
             Use "Explain Credential Status" only when the user asks to:
             - Explain the current status and stage
             - What does this status mean?
             - Explain Verification
             - Explain Pending Review
             - Explain Committee Review
             - Explain Approved
             - Explain Rejected
             Use "Missing Document Identification" when the user asks to:
             Use this action when users ask about missing, pending, outstanding, or required credentialing documents.
             Examples:
             - What documents are missing?
             - How many documents are missing?
             - Show pending documents.
             - Show outstanding requirements.
             - Check missing documents.
             Behavior:
             - Identify missing credentialing documents and provide the missing document list and count.
             - When missing documents are identified, a reminder email is automatically sent to the provider and the response should clearly state that the reminder email was sent.
             - When no missing documents are identified, do not send an email and inform the user that all required documents have already been submitted.
             If no credential record is found:
             - Inform the user politely that no matching credential was found.
             - Ask the user to verify the Credential ID and try again.
             Keep responses concise, professional, and avoid mentioning internal actions, flows, or system processing
        actions:
            Get_Credentialing_Summary: @actions.Get_Credentialing_Summary
                with credentialId = ...
            Explaining_Credentialing_Status: @actions.Explaining_Credentialing_Status
                with credentialId = ...
            Identifying_the_missing_documents: @actions.Identifying_the_missing_documents
                with credentialId = ...







    actions:
        Get_Credentialing_Summary:
            label: "Get Credentialing Summary"
            description: "Collect all credentialing information and prepare summary"
            target: "flow://Get_Credentialing_Summary"
            inputs:
                credentialId: string
                    label: "credentialId"
                    description: ""
                    is_required: False
                    complex_data_type_name: "lightning__textType"
            outputs:
                SummaryCommitteeDate: string
                    label: "SummaryCommitteeDate"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryExpectedDate: string
                    label: "SummaryExpectedDate"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryMissingDoc: string
                    label: "SummaryMissingDoc"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryNPI: string
                    label: "SummaryNPI"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryProviderName: string
                    label: "SummaryProviderName"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryStage: string
                    label: "SummaryStage"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                SummaryStatus: string
                    label: "SummaryStatus"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False

        Explaining_Credentialing_Status:
            label: "Explaining Credentialing Status"
            description: "Explaning the current status"
            target: "flow://Get_Credential_Status"
            inputs:
                credentialId: string
                    label: "credentialId"
                    description: ""
                    is_required: False
                    complex_data_type_name: "lightning__textType"
            outputs:
                statusExplanation: string
                    label: "statusExplanation"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False

        Identifying_the_missing_documents:
            label: "Identifying the missing documents"
            description: "Identifying the missing documents and sending alert mail"
            target: "flow://Identify_Missing_Documents"
            inputs:
                credentialId: string
                    label: "credentialId"
                    description: ""
                    is_required: False
                    complex_data_type_name: "lightning__textType"
            outputs:
                missingCount: number
                    label: "missingCount"
                    description: ""
                    complex_data_type_name: "lightning__numberType"
                    is_displayable: False
                    filter_from_agent: False
                missingDocumentList: string
                    label: "missingDocumentList"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
                missingDocumentResponse: string
                    label: "missingDocumentResponse"
                    description: ""
                    complex_data_type_name: "lightning__textType"
                    is_displayable: False
                    filter_from_agent: False
