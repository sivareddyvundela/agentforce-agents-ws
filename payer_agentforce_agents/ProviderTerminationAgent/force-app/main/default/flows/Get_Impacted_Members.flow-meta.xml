<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Append_Member_Details</name>
        <label>Append Member Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>memberSummary</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentMemberDetails</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Member_Count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_No_Member_details</name>
        <label>Assign No Member details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>memberSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No impacted members were found for this provider</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>memberCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Member_Count</name>
        <label>Set Member Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>memberCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_members</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Members_Found</name>
        <label>Members Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_No_Member_details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>MembersFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Impacted_Members</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_members</targetReference>
            </connector>
            <label>Members Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Get Impacted Members {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Impacted Members</label>
    <loops>
        <name>Loop_through_members</name>
        <label>Loop through members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Impacted_Members</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Member_Details</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Impacted_Members</name>
        <label>Get Impacted Members</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Members_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Healthcare_Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>providerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Impacted_Members</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>CurrentMemberDetails</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Name: {!Loop_through_members.Name}
Phone: {!Loop_through_members.Phone}
Email: {!Loop_through_members.PersonEmail}
---------------------------------------------------------</text>
    </textTemplates>
    <variables>
        <name>memberCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>memberSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>This is the Healthcare Provider Id</description>
        <name>providerId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
